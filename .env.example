# BOT Chain details verified at https://dev-docs.botchain.ai/docs/Account-Abstraction/network-and-endpoints
NEXT_PUBLIC_BOT_CHAIN_ID=968
NEXT_PUBLIC_BOT_CHAIN_NAME=BOT Chain Testnet
NEXT_PUBLIC_BOT_RPC_URL=https://rpc.bohr.life
NEXT_PUBLIC_BOT_EXPLORER_URL=https://scan.bohr.life

# Fill these after deployment. Chain reads and writes stay disabled without addresses.
NEXT_PUBLIC_AGENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_AGENT_REPUTATION_ADDRESS=
NEXT_PUBLIC_AGENT_PERMISSIONS_ADDRESS=
NEXT_PUBLIC_AGENT_SPENDING_ADDRESS=

# Server-only AI provider configuration. Never use NEXT_PUBLIC_ for secrets.
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=gpt-4o-mini

# Deployment only. Never commit a real private key.
BOT_CHAIN_TESTNET_RPC_URL=https://rpc.bohr.life
BOT_CHAIN_MAINNET_RPC_URL=https://rpc.botchain.ai
DEPLOYER_PRIVATE_KEY=
